<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration>
  <data:scalar name="Temperature"/>
  <data:scalar name="Qnet"/>
  <data:vector name="Lorentz"/>

  <mesh name="Fluid-Mesh" dimensions="3">
    <use-data name="Temperature"/>
    <use-data name="Qnet"/>
    <use-data name="Lorentz"/>
  </mesh>

  <participant name="Fluid">
    <provide-mesh name="Fluid-Mesh"/>
    <write-data name="Temperature" mesh="Fluid-Mesh"/>
    <read-data name="Qnet" mesh="Fluid-Mesh"/>
    <read-data name="Lorentz" mesh="Fluid-Mesh"/>
  </participant>

  <participant name="EM">
    <receive-mesh name="Fluid-Mesh" from="Fluid" api-access="true"/>
    <read-data name="Temperature" mesh="Fluid-Mesh"/>
    <write-data name="Qnet" mesh="Fluid-Mesh"/>
    <write-data name="Lorentz" mesh="Fluid-Mesh"/>
  </participant>

  <m2n:sockets acceptor="Fluid" connector="EM" exchange-directory="."/>

  <coupling-scheme:serial-explicit>
    <participants first="Fluid" second="EM"/>
    <max-time value="2.6e-3"/>
    <time-window-size value="1.0e-5"/>
    <exchange data="Temperature" mesh="Fluid-Mesh" from="Fluid" to="EM"/>
    <exchange data="Qnet" mesh="Fluid-Mesh" from="EM" to="Fluid"/>
    <exchange data="Lorentz" mesh="Fluid-Mesh" from="EM" to="Fluid"/>
  </coupling-scheme:serial-explicit>
</precice-configuration>
