FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      preciceDict;
}

preciceConfig   "precice-config.xml";
participant     Fluid;
modules         (generic);

interfaces
{
    Interface1
    {
        mesh        Fluid-Mesh;
        patches     ();
        locations   volumeCenters;

        writeData
        (
            Temperature
            {
                name        Temperature;
                solver_name T;
            }
        );

        readData
        (
            Qnet
            {
                name        Qnet;
                solver_name Qnet;
            }
            Lorentz
            {
                name        Lorentz;
                solver_name Lorentz;
            }
        );
    }
}
