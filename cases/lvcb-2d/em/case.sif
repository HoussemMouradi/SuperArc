! Elmer input for the planar breaker arc (StatCurrentSolver).
! ElmerSolver reads em/work/case.sif. This copy is the file from the last
! coupling window of the reference run, so the gas conductivities below are
! that window's bins. em/em_participant.py rewrites em/work/case.sif every
! window: the solver block and the two terminals stay as written here, and
! the gas materials are replaced from the OpenFOAM temperature.
!
! Bodies 1-8: contacts and splitter plates, Material 1, 1e5 S/m.
! Bodies 9 and above: gas conductivity bins.
! Boundary Condition 1: upper-runner terminal, unit voltage.
! Boundary Condition 2: lower-runner terminal, Potential = 0.
! Every other edge keeps zero normal current.
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "elmermesh"
  Results Directory "."
End

Simulation
  Max Output Level = 4
  Coordinate System = Cartesian 2D
  Simulation Type = Steady state
  Steady State Max Iterations = 1
  Output Intervals(1) = 1
End

Solver 1
  Equation = Stat Current Solver
  Procedure = "StatCurrentSolve" "StatCurrentSolver"
  Variable = Potential
  Calculate Volume Current = Logical True
  Calculate Joule Heating = Logical True
  Calculate Electric Field = Logical True
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Preconditioning = ILU1
  Linear System Max Iterations = 2000
  Linear System Convergence Tolerance = 1.0e-8
  Nonlinear System Max Iterations = 1
  Nonlinear System Convergence Tolerance = 1.0e-6
  Steady State Convergence Tolerance = 1.0e-6
End

Solver 2
  Exec Solver = After Saving
  Equation = Result Output
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = em
  Output Format = Vtu
  Binary Output = Logical False
  Single Precision = Logical False
End

Equation 1
  Active Solvers(1) = 1
End

Material 1
  Electric Conductivity = 1.0e5
End
Material 2
  Electric Conductivity = 2.236762e-04
End
Material 3
  Electric Conductivity = 2.915537e-01
End
Material 4
  Electric Conductivity = 8.107251e-01
End
Material 5
  Electric Conductivity = 2.289364e+00
End
Material 6
  Electric Conductivity = 6.567795e+00
End
Material 7
  Electric Conductivity = 2.068433e+01
End
Material 8
  Electric Conductivity = 5.114616e+01
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End
Body 2
  Target Bodies(1) = 2
  Equation = 1
  Material = 1
End
Body 3
  Target Bodies(1) = 3
  Equation = 1
  Material = 1
End
Body 4
  Target Bodies(1) = 4
  Equation = 1
  Material = 1
End
Body 5
  Target Bodies(1) = 5
  Equation = 1
  Material = 1
End
Body 6
  Target Bodies(1) = 6
  Equation = 1
  Material = 1
End
Body 7
  Target Bodies(1) = 7
  Equation = 1
  Material = 1
End
Body 8
  Target Bodies(1) = 8
  Equation = 1
  Material = 1
End
Body 9
  Target Bodies(1) = 9
  Equation = 1
  Material = 2
End
Body 10
  Target Bodies(1) = 10
  Equation = 1
  Material = 3
End
Body 11
  Target Bodies(1) = 11
  Equation = 1
  Material = 4
End
Body 12
  Target Bodies(1) = 12
  Equation = 1
  Material = 5
End
Body 13
  Target Bodies(1) = 13
  Equation = 1
  Material = 6
End
Body 14
  Target Bodies(1) = 14
  Equation = 1
  Material = 7
End
Body 15
  Target Bodies(1) = 15
  Equation = 1
  Material = 8
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Potential = Real 1.0
End
Boundary Condition 2
  Target Boundaries(1) = 2
  Potential = Real 0.0
End
